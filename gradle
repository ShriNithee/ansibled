build common for all
  

plugins {
    id 'application'
}

application {
    mainClass = 'org.example.Main'
}

tasks.named('run') {
    standardInput = System.in
}

jar {
    manifest {
        attributes 'Main-Class': 'org.example.Main'
    }
}


